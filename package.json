{
  "name": "unife",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @unife/web",
    "api:dev": "npm run dev --workspace @unife/api",
